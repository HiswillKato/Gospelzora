# Runtime artifacts
install.lock

# Environment secrets
.env
.env.*
!.env.example

# Per-server configuration. app/config.php holds the committed defaults;
# app/config.local.php holds the real database password, mail password and the
# production domain, and is loaded on top of it. It must never be committed.
app/config.local.php

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
*~

# VS Code workspace files are machine-specific and should not be committed.
*.code-workspace
AGENTS.md

# Audio files
*.mp3
*.wav
*.ogg
*.flac
*.m4a
*.aac

