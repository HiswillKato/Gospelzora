Options -Indexes
DirectoryIndex index.php
RewriteEngine On
RewriteBase /

# Dotfiles and deployment/configuration artifacts are never public.
RewriteRule (^|/)\. - [F,L]
RewriteRule \.(?:env|ini|log|sql|lock|bak|swp|dist)$ - [F,NC,L]

# Uploaded files are data, never executable PHP or scripts.
RewriteRule ^(?:assets|uploads)/(?:.*/)?[^/]+\.(?:php[0-9]?|phtml|phar|cgi|pl|py|sh)$ - [F,NC,L]

# Serve real public files (CSS, JS, images, audio, fonts, robots, favicon).
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Application URLs go through the only PHP entry point.
RewriteRule ^ index.php [L,QSA]
