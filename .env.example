# Gospelzora application environment
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=Africa/Kampala
BASE_URL=https://your-gospelzora-domain.example/
GOSPELZORA_HOSTS=your-gospelzora-domain.example,www.your-gospelzora-domain.example

# Database — use a dedicated, least-privileged MySQL account
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=gospelzora
DB_USER=gospelzora
DB_PASS=replace-with-a-long-random-password

# Mail
MAIL_HOST=127.0.0.1
MAIL_PORT=25
MAIL_FROM=gospelzora@example.com
MAIL_FROM_NAME=Gospelzora
MAIL_USER=
MAIL_PASS=
MAIL_ADMIN=gospelzora@example.com

# Cloudflare R2 (S3-compatible API) — keep the bucket private
# Keep disabled until local media is migrated with scripts/migrate-local-media-to-r2.php --apply.
R2_ENABLED=false
R2_ACCOUNT_ID=
R2_REGION=auto
R2_BUCKET=
R2_ACCESS_KEY=
R2_SECRET_KEY=
# Optional override; defaults to https://<account-id>.r2.cloudflarestorage.com
R2_ENDPOINT=

# Optional: deliver media via a Cloudflare Worker on your domain (hides R2 URLs).
# Set both and deploy the Worker; leave empty to fall back to presigned R2 URLs.
R2_MEDIA_URL=
R2_MEDIA_SECRET=
