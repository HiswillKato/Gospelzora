# Gospelzora application environment
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=Africa/Kampala
BASE_URL=https://your-gospelzora-domain.example/
GOSPELZORA_HOSTS=your-gospelzora-domain.example,www.your-gospelzora-domain.example

# Database — use a dedicated, least-privileged MySQL account
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=gospelzora
DB_USER=gospelzora
DB_PASS=replace-with-a-long-random-password

# Mail
MAIL_HOST=127.0.0.1
MAIL_PORT=25
MAIL_FROM=gospelzora@example.com
MAIL_FROM_NAME=Gospelzora
MAIL_USER=
MAIL_PASS=
MAIL_ADMIN=gospelzora@example.com

# Oracle Cloud Object Storage (Amazon S3-compatible API)
# Keep disabled until local media is migrated with scripts/migrate-local-media-to-oci.php --apply.
OCI_OBJECT_STORAGE_ENABLED=false
OCI_OBJECT_STORAGE_NAMESPACE=
OCI_OBJECT_STORAGE_REGION=
OCI_OBJECT_STORAGE_BUCKET=
OCI_OBJECT_STORAGE_ACCESS_KEY=
OCI_OBJECT_STORAGE_SECRET_KEY=
# Optional override; defaults to https://<namespace>.compat.objectstorage.<region>.oraclecloud.com
OCI_OBJECT_STORAGE_ENDPOINT=
