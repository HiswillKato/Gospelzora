# Gospelzora application environment
APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=Africa/Kampala
BASE_URL=https://your-gospelzora-domain.example/
GOSPELZORA_HOSTS=your-gospelzora-domain.example,www.your-gospelzora-domain.example

# Database — use a dedicated, least-privileged MySQL account
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=gospelzora
DB_USER=gospelzora
DB_PASS=replace-with-a-long-random-password

# Mail
MAIL_HOST=127.0.0.1
MAIL_PORT=25
MAIL_FROM=gospelzora@example.com
MAIL_FROM_NAME=Gospelzora
MAIL_USER=
MAIL_PASS=
MAIL_ADMIN=gospelzora@example.com
